PORT=5000

# Leave MONGODB_URI unset (or keep it as the default local URI below) to run
# with a zero-setup, in-memory MongoDB — no install required, perfect for a
# hackathon demo. Data resets on every server restart in this mode.
#
# To use a real/persistent database instead (e.g. MongoDB Atlas), set
# MONGODB_URI to that connection string and the app will use it automatically.
MONGODB_URI=mongodb://localhost:27017/pulselink

JWT_SECRET=pulselink_secret_key_change_this_in_production
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the local dev ports (Vite on 8080, per vite.config.ts) if unset.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Optional — enables the AI features (richer explanations on
# recommendations, and the "Ask PulseLink" copilot chat), via Groq's free
# API. Get a key at https://console.groq.com/keys (no card required). If
# left unset, both features fall back gracefully: recommendations show
# their existing rule-based explanation, and the copilot tells the user
# it isn't configured yet. Nothing else in the app depends on this.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
